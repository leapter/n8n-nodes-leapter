{
	"name": "n8n-nodes-leapter",
	"version": "0.0.0-development",
	"description": "n8n community node for Leapter: run the public blueprints deployed to a Leapter Runtime Cluster",
	"license": "MIT",
	"author": {
		"name": "Leapter",
		"email": "developers@leapter.com"
	},
	"homepage": "https://github.com/leapter/n8n-nodes-leapter#readme",
	"keywords": [
		"n8n-community-node-package"
	],
	"main": "dist/nodes/Leapter/Leapter.node.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/leapter/n8n-nodes-leapter.git"
	},
	"bugs": {
		"url": "https://github.com/leapter/n8n-nodes-leapter/issues"
	},
	"engines": {
		"node": ">=20.19"
	},
	"packageManager": "pnpm@10.26.0",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "tsc && node --test test/*.test.mjs",
		"e2e": "bash e2e/run.sh",
		"e2e:queue": "bash e2e/queue.sh",
		"check:public": "bash scripts/check-public.sh",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/LeapterApi.credentials.js",
			"dist/credentials/LeapterOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Leapter/Leapter.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.54.3",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"pnpm": {
		"overrides": {
			"axios@<1.20.0": "^1.20.0",
			"qs@<6.16.0": "^6.16.0",
			"uuid@10.0.0": "11.1.1"
		}
	}
}
